{
  "name": "@t4dhg/mcp-eudamed",
  "version": "0.1.1",
  "mcpName": "io.github.t4dhg/mcp-eudamed",
  "description": "Read-only EUDAMED MCP server: device discovery, economic operators, reference decoding and traceable evidence investigations.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-eudamed": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "llms.txt",
    "LICENSE",
    "docs/",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage && npm run build",
    "test:stdio": "npm run build && node scripts/stdio-smoke.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs"
  },
  "keywords": [
    "mcp",
    "eudamed",
    "medical-devices",
    "udi",
    "regulatory",
    "model-context-protocol"
  ],
  "author": "Taig Mac Carthy <https://taigmaccarthy.com/>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.2",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4dhg/mcp-eudamed.git"
  },
  "homepage": "https://github.com/t4dhg/mcp-eudamed#readme",
  "bugs": {
    "url": "https://github.com/t4dhg/mcp-eudamed/issues"
  }
}
